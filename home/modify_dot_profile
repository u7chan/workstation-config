#!/usr/bin/env bash
set -euo pipefail

awk '
  function emit_managed_block() {
    print "# BEGIN workstation-config"
    print "# ~/.profile prepends $HOME/bin and $HOME/.local/bin after it has"
    print "# sourced ~/.bashrc, so the mise shims added by init.bash end up"
    print "# behind user-local binaries. Re-prepend the shims here so login"
    print "# shells resolve mise-managed tools too. No-op without mise."
    print "# POSIX sh syntax: POSIX login shells read this file as well."
    print "if [ -x \"$HOME/.local/bin/mise\" ]; then"
    print "  eval \"$(\"$HOME/.local/bin/mise\" activate bash --shims)\""
    print "elif command -v mise >/dev/null 2>&1; then"
    print "  eval \"$(mise activate bash --shims)\""
    print "fi"
    print "# END workstation-config"
  }

  $0 == "# BEGIN workstation-config" {
    if (!emitted) {
      emit_managed_block()
      emitted = 1
    }
    in_managed_block = 1
    next
  }

  $0 == "# END workstation-config" && in_managed_block {
    in_managed_block = 0
    next
  }

  !in_managed_block { print }

  END {
    if (!emitted) {
      if (NR > 0) print ""
      emit_managed_block()
    }
  }
'
