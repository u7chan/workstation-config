#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
readonly ROOT_DIR
readonly FRAGMENT_PATH="$ROOT_DIR/claude/settings.json"
readonly SETTINGS_DIR="${HOME:?}/.claude"
readonly SETTINGS_PATH="$SETTINGS_DIR/settings.json"
# Only these paths are owned by the repository. Everything else in the user's
# settings.json is preserved.
readonly MANAGED_PATHS='[["theme"],["statusLine"],["permissions","defaultMode"],["syncClaudeAiSkills"],["syncClaudeAiPlugins"]]'

die() {
  printf 'merge-claude-settings: %s\n' "$*" >&2
  exit 1
}

[[ -r $FRAGMENT_PATH ]] || die "cannot read settings fragment: $FRAGMENT_PATH"
command -v jq >/dev/null 2>&1 || die "jq is required"

umask 077
mkdir -p -- "$SETTINGS_DIR"

if ! jq -e --argjson paths "$MANAGED_PATHS" '
  . as $fragment
  | if type == "object"
    then [$paths[] | . as $path | ($fragment | getpath($path)) != null] | all
    else false
    end
' "$FRAGMENT_PATH" >/dev/null; then
  die "settings fragment must be a JSON object defining every managed path: $MANAGED_PATHS"
fi

if [[ -e $SETTINGS_PATH ]]; then
  if ! jq -e 'type == "object"' "$SETTINGS_PATH" >/dev/null; then
    die "existing settings must be a JSON object: $SETTINGS_PATH"
  fi
fi

temporary_path=""
cleanup() {
  if [[ -n $temporary_path ]]; then
    rm -f -- "$temporary_path"
  fi
}
trap cleanup EXIT

temporary_path="$(mktemp --tmpdir="$SETTINGS_DIR" '.settings.json.tmp.XXXXXXXXXX')"

if [[ -e $SETTINGS_PATH ]]; then
  jq -s --argjson paths "$MANAGED_PATHS" '
    .[0] as $existing
    | .[1] as $fragment
    | reduce $paths[] as $path ($existing; setpath($path; ($fragment | getpath($path))))
  ' "$SETTINGS_PATH" "$FRAGMENT_PATH" >"$temporary_path"
  chmod --reference="$SETTINGS_PATH" "$temporary_path"
else
  jq -s --argjson paths "$MANAGED_PATHS" '
    .[0] as $fragment
    | reduce $paths[] as $path ({}; setpath($path; ($fragment | getpath($path))))
  ' "$FRAGMENT_PATH" >"$temporary_path"
fi

mv -f -- "$temporary_path" "$SETTINGS_PATH"
temporary_path=""
trap - EXIT
