#!/usr/bin/env bash
set -euo pipefail

die() {
  printf 'update-ai: %s\n' "$*" >&2
  exit 1
}

if [[ ${UPDATE_AI_MISE_ACTIVE:-} != 1 ]]; then
  mise_bin="$HOME/.local/bin/mise"
  [[ -x $mise_bin ]] || die "mise is required"
  UPDATE_AI_MISE_ACTIVE=1 exec "$mise_bin" exec node -- "$0" "$@"
fi
unset UPDATE_AI_MISE_ACTIVE

command -v node >/dev/null 2>&1 || die "mise-managed Node.js is required"
command -v npm >/dev/null 2>&1 || die "npm is required"
command -v curl >/dev/null 2>&1 || die "curl is required"
[[ -r "$HOME/.safe-chain/scripts/init-posix.sh" ]] || die "Safe-chain shell integration is required"

readonly -a PI_PACKAGE_SOURCES=(
  "npm:pi-web-access"
  "npm:pi-codex-image-gen"
  "npm:@howaboua/pi-codex-conversion"
  "npm:@ogulcancelik/pi-session-recall"
)
readonly PI_PACKAGE_NAME="@earendil-works/pi-coding-agent"
readonly PI_MINIMUM_VERSION_MAJOR=0
readonly PI_MINIMUM_VERSION_MINOR=84
readonly PI_MINIMUM_VERSION_PATCH=2
readonly NODE_MINIMUM_VERSION_MAJOR=22
readonly NODE_MINIMUM_VERSION_MINOR=19
readonly NODE_MINIMUM_VERSION_PATCH=0

# Safe-chain blocks downloads of packages newer than its minimum package age
# (48 hours by default). The Pi core install skips that gate, but the Pi
# packages keep it, so resolve their npm versions against the same cutoff and
# never request a package the gate would block. One hour of margin keeps the
# registry cutoff ahead of the gate.
safe_chain_minimum_package_age_hours() {
  local age_hours=${SAFE_CHAIN_MINIMUM_PACKAGE_AGE_HOURS:-48}
  [[ $age_hours =~ ^[0-9]+$ ]] || die "SAFE_CHAIN_MINIMUM_PACKAGE_AGE_HOURS must be a whole number of hours: $age_hours"
  printf '%s' "$age_hours"
}

compute_npm_before() {
  local age_hours
  age_hours="$(safe_chain_minimum_package_age_hours)"
  date -u -d "@$(( $(date +%s) - (age_hours + 1) * 3600 ))" +%Y-%m-%dT%H:%M:%SZ
}

version_ge() {
  local version=$1
  local min_major=$2
  local min_minor=$3
  local min_patch=$4
  local major minor patch
  # Strict semver: no optional "v" prefix. Callers that receive one (e.g.
  # `node --version`) strip it before calling, matching the length of the
  # check the per-tool wrappers performed before unification.
  if [[ ! $version =~ ^([0-9]+)\.([0-9]+)\.([0-9]+)(\+.*)?$ ]]; then
    return 1
  fi
  major=${BASH_REMATCH[1]}
  minor=${BASH_REMATCH[2]}
  patch=${BASH_REMATCH[3]}
  ((major > min_major)) || \
    ((major == min_major && minor > min_minor)) || \
    ((major == min_major && minor == min_minor && patch >= min_patch))
}

# Report whether the first version precedes the second. Every caller compares
# plain release versions from npm dist-tags or Pi, so a version sort is enough.
version_lt() {
  local first=$1
  local second=$2
  local sorted

  [[ $first != "$second" ]] || return 1
  sorted="$(printf '%s\n%s\n' "$first" "$second" | sort -V)"
  [[ ${sorted%%$'\n'*} == "$first" ]]
}

# write_json_file <target_path> <temp_prefix> <kind> <update_subject> <jq_program> [jq_option...]
#
# Atomically write <target_path> as JSON with jq, replacing the duplicated
# mktemp -> jq -> chmod -> mv -> trap cleanup block of the callers. The
# callers are responsible for the directory setup and the file checks that
# must run before any early return or probe.
write_json_file() {
  local target_path=$1
  local temp_prefix=$2
  local kind=$3
  local update_subject=$4
  local jq_program=$5
  shift 5
  local -a jq_options=("$@")
  local target_dir temporary_path

  target_dir="$(dirname -- "$target_path")"

  temporary_path="$(mktemp "$target_dir/$temp_prefix.XXXXXXXXXX")"
  cleanup_temp() {
    [[ -z $temporary_path ]] || rm -f -- "$temporary_path"
  }
  trap cleanup_temp EXIT

  if [[ -f $target_path ]]; then
    jq "${jq_options[@]}" "$jq_program" "$target_path" >"$temporary_path" || \
      die "could not update $update_subject: $target_path"
    chmod --reference="$target_path" "$temporary_path"
  else
    jq -n "${jq_options[@]}" "$jq_program" >"$temporary_path" || \
      die "could not create $kind: $target_path"
    chmod 0600 "$temporary_path"
  fi

  mv -- "$temporary_path" "$target_path"
  temporary_path=""
  trap - EXIT
}

require_supported_node() {
  local node_version
  node_version="$(node --version)" || die "could not determine Node.js version"
  version_ge "${node_version#v}" \
    "$NODE_MINIMUM_VERSION_MAJOR" "$NODE_MINIMUM_VERSION_MINOR" "$NODE_MINIMUM_VERSION_PATCH" || \
    die "Node.js >= ${NODE_MINIMUM_VERSION_MAJOR}.${NODE_MINIMUM_VERSION_MINOR}.${NODE_MINIMUM_VERSION_PATCH} is required for Pi packages (found: $node_version)"
}

configure_pi_npm_command() {
  command -v jq >/dev/null 2>&1 || die "jq is required to configure Pi's npm command"

  local pi_agent_dir="${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}"
  local settings_path="$pi_agent_dir/settings.json"
  local expected_npm_command='["mise","exec","node","--","safe-chain","npm"]'

  mkdir -p -- "$pi_agent_dir"
  chmod 0700 -- "$pi_agent_dir"
  if [[ -e $settings_path && ! -f $settings_path ]]; then
    die "Pi settings path is not a regular file: $settings_path"
  fi

  if [[ -f $settings_path ]]; then
    jq -e 'type == "object"' "$settings_path" >/dev/null || \
      die "Pi settings must contain a JSON object: $settings_path"
    if jq -e --argjson expected "$expected_npm_command" \
      '.npmCommand == $expected' "$settings_path" >/dev/null; then
      return 0
    fi
  fi

  # shellcheck disable=SC2016  # jq program stays literal when passed as an argument
  write_json_file "$settings_path" ".settings.json.tmp" "Pi settings" "Pi npm command" \
    '.npmCommand = $npm_command' --argjson npm_command "$expected_npm_command"
}

configure_pi_codex_conversion() {
  command -v jq >/dev/null 2>&1 || die "jq is required to configure Pi Codex conversion"

  local pi_agent_dir="${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}"
  local config_path="$pi_agent_dir/pi-codex-conversion.json"

  mkdir -p -- "$pi_agent_dir"
  chmod 0700 -- "$pi_agent_dir"
  if [[ -e $config_path && ! -f $config_path ]]; then
    die "Pi Codex conversion config path is not a regular file: $config_path"
  fi

  if [[ -f $config_path ]]; then
    jq -e 'type == "object"' "$config_path" >/dev/null || \
      die "Pi Codex conversion config must contain a JSON object: $config_path"
  fi

  write_json_file "$config_path" ".pi-codex-conversion.json.tmp" \
    "Pi Codex conversion config" "Pi Codex conversion config" \
    '
      .tools = (if (.tools? | type) == "object" then .tools else {} end)
      | .tools.webRun = false
      | .tools.imageGeneration = false
      | .tools.webRunOnly = false
      | .tools.imageGenerationOnly = false
    '
}

require_supported_pi() {
  command -v pi >/dev/null 2>&1 || die "Pi CLI is required"
  local pi_version
  pi_version="$(NO_COLOR=1 pi --version)" || die "could not determine Pi version"
  version_ge "$pi_version" \
    "$PI_MINIMUM_VERSION_MAJOR" "$PI_MINIMUM_VERSION_MINOR" "$PI_MINIMUM_VERSION_PATCH" || \
    die "Pi >= ${PI_MINIMUM_VERSION_MAJOR}.${PI_MINIMUM_VERSION_MINOR}.${PI_MINIMUM_VERSION_PATCH} is required for the selected Pi packages (found: $pi_version)"
}

pi_package_is_installed() {
  local source=$1
  local package_list
  package_list="$(NO_COLOR=1 pi list --no-approve)" || return 1
  awk -v source="$source" '
    /^User packages:$/ { in_user = 1; next }
    /^Project packages:$/ { in_user = 0 }
    in_user {
      package_source = $0
      sub(/^  /, "", package_source)
      sub(/ \(filtered\)$/, "", package_source)
      if (package_source == source) found += 1
    }
    END { exit found != 1 }
  ' <<<"$package_list"
}

pi_package_installed_version() {
  local package_name=$1
  local package_json="${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}/npm/node_modules/$package_name/package.json"
  local installed

  [[ -r $package_json ]] || return 1
  installed="$(jq -r '.version // empty' "$package_json" 2>/dev/null)" || return 1
  [[ -n $installed ]] || return 1
  printf '%s' "$installed"
}

# Read the newest published version, the second it becomes installable, and
# its publish timestamp from the registry. The second rounds the publish time
# up because npm's before cutoff is a whole second and npm-pick-manifest keeps
# a version when Date.parse(published) <= cutoff. The query skips the age gate
# because the gate suppresses versions younger than the cutoff in the metadata
# and appends its notice to stdout, which would both hide the version the
# report must show and break the JSON parse. Nothing is downloaded here, so
# the malware scan has nothing to inspect.
registry_package_release() {
  local package_name=$1
  local response latest published published_epoch published_nanoseconds

  response="$(NO_COLOR=1 npm view "$package_name" dist-tags time --json --safe-chain-skip-minimum-package-age 2>/dev/null)" || return 1
  [[ -n $response ]] || return 1
  latest="$(jq -r '(if type == "array" then .[0] else . end)."dist-tags".latest // empty' <<<"$response" 2>/dev/null)" || return 1
  [[ -n $latest ]] || return 1
  published="$(jq -r --arg version "$latest" '(if type == "array" then .[0] else . end).time[$version] // empty' <<<"$response" 2>/dev/null)" || return 1
  published_epoch="$(date -u -d "$published" +%s 2>/dev/null)" || return 1
  published_nanoseconds="$(date -u -d "$published" +%N 2>/dev/null)" || return 1
  if [[ ! $published_nanoseconds =~ ^0*$ ]]; then
    published_epoch=$((published_epoch + 1))
  fi
  printf '%s\t%s\t%s\n' "$latest" "$published_epoch" "$published"
}

# Print one version status line for a target that update-ai just installed.
# The installers print no version, so without this line a version held back by
# the age gate is indistinguishable from a target that is already current. The
# deferral is decided against the cutoff the installs actually used instead of
# the report time, because a run that crosses the gate deadline must not report
# a legitimate deferral as an update that did not take effect. A lookup failure
# stays advisory: metadata queries must not fail an update whose installs
# succeeded. <gate> is "skipped" for the Pi core, whose install passes
# --safe-chain-skip-minimum-package-age, and "active" for the Pi packages.
pi_version_line() {
  local label=$1
  local package_name=$2
  local installed=$3
  local age_hours=$4
  local cutoff_epoch=$5
  local gate=$6
  local latest published published_epoch release_epoch

  if [[ -z $installed ]]; then
    printf '%s (installed version unknown)\n' "$label"
    return 0
  fi

  if ! IFS=$'\t' read -r latest published_epoch published < <(registry_package_release "$package_name"); then
    if [[ $gate == skipped ]]; then
      printf '%s %s (registry lookup failed; update status unknown)\n' "$label" "$installed"
    else
      printf '%s %s (registry lookup failed; age gate status unknown)\n' "$label" "$installed"
    fi
    return 0
  fi

  if [[ $gate == skipped ]]; then
    if ! version_lt "$installed" "$latest"; then
      printf '%s %s (age gate skipped)\n' "$label" "$installed"
    else
      printf '%s %s -> %s\n' "$label" "$installed" "$latest"
      printf 'update-ai: %s %s is behind %s while the age gate is skipped; the update did not take effect\n' \
        "$label" "$installed" "$latest" >&2
    fi
    return 0
  fi

  release_epoch=$((published_epoch + (age_hours + 1) * 3600))
  if ! version_lt "$installed" "$latest"; then
    printf '%s %s (newest allowed version)\n' "$label" "$installed"
  elif ((published_epoch > cutoff_epoch)); then
    printf '%s %s -> %s deferred until %s (published %s)\n' \
      "$label" "$installed" "$latest" \
      "$(date -u -d "@$release_epoch" +%Y-%m-%dT%H:%M:%SZ)" "$published"
  else
    printf '%s %s -> %s\n' "$label" "$installed" "$latest"
    printf 'update-ai: %s %s is behind %s, which is already past the age gate; the update did not take effect\n' \
      "$label" "$installed" "$latest" >&2
  fi
}

report_pi_versions() {
  local npm_before=${1:?npm before timestamp is required}
  local age_hours cutoff_epoch package_name source installed

  age_hours="$(safe_chain_minimum_package_age_hours)"
  cutoff_epoch="$(date -u -d "$npm_before" +%s 2>/dev/null)" || \
    die "could not read the npm cutoff used for the Pi installs: $npm_before"
  printf '==> Pi versions (Safe-chain minimum package age: %sh)\n' "$age_hours"

  pi_version_line pi "$PI_PACKAGE_NAME" "$(NO_COLOR=1 pi --version 2>/dev/null || true)" \
    "$age_hours" "$cutoff_epoch" skipped

  for source in "${PI_PACKAGE_SOURCES[@]}"; do
    package_name=${source#npm:}
    installed="$(pi_package_installed_version "$package_name" || true)"
    pi_version_line "$source" "$package_name" "$installed" "$age_hours" "$cutoff_epoch" active
  done
}

ensure_pi_packages() {
  local npm_before=${1:?npm before timestamp is required}
  local source

  require_supported_pi
  configure_pi_npm_command

  for source in "${PI_PACKAGE_SOURCES[@]}"; do
    [[ $source == npm:* ]] || die "Unsupported Pi package source: $source"

    printf '==> Ensuring Pi package %s through Pi\n' "$source"
    if pi_package_is_installed "$source"; then
      NO_COLOR=1 npm_config_before="$npm_before" \
        pi update "$source" --no-approve
    else
      NO_COLOR=1 npm_config_before="$npm_before" \
        pi install "$source" --no-approve
    fi

    pi_package_is_installed "$source" || \
      die "Pi package was not registered exactly once in the user scope: $source"
  done

  configure_pi_codex_conversion
}

install_claude=false
install_opencode=false
install_pi=false

if [[ $# -eq 0 ]]; then
  install_claude=true
  install_opencode=true
  install_pi=true
else
  for arg in "$@"; do
    case "$arg" in
      --claude) install_claude=true ;;
      --opencode) install_opencode=true ;;
      --pi) install_pi=true ;;
      *) die "Unknown option: $arg" ;;
    esac
  done
fi

# Load Safe-chain's npm wrapper. Malware inspection stays active because
# Safe-chain itself is not bypassed.
# shellcheck disable=SC1091
source "$HOME/.safe-chain/scripts/init-posix.sh"
export PATH="$HOME/.opencode/bin:$HOME/.local/bin:$PATH"

if [[ $install_pi == true ]]; then
  require_supported_node
  printf '==> Updating Pi coding agent through Safe-chain (age gate skipped)\n'
  # The core dependency tree keeps hitting the age gate on freshly published
  # transitive dependencies, and opening each scope in the exclusion list would
  # exempt executable packages. Skip the gate for this install instead; the
  # malware scan still inspects every download.
  npm install --global --ignore-scripts "$PI_PACKAGE_NAME@latest" \
    --safe-chain-skip-minimum-package-age

  # The Pi packages are third-party and keep the age gate, so align their npm
  # resolution with the cutoff the gate enforces.
  pi_packages_npm_before="$(compute_npm_before)"
  ensure_pi_packages "$pi_packages_npm_before"
  report_pi_versions "$pi_packages_npm_before"
fi

if [[ $install_claude == true ]]; then
  printf '==> Updating Claude Code from the official native installer\n'
  curl -fsSL https://claude.ai/install.sh | bash
fi

if [[ $install_opencode == true ]]; then
  printf '==> Updating OpenCode 2 from the official binary installer\n'
  curl -fsSL https://opencode.ai/v2/install | bash -s -- --no-modify-path
fi

printf '==> AI CLI versions\n'
if [[ $install_pi == true ]]; then
  pi --version
fi
if [[ $install_claude == true ]]; then
  claude --version
fi
if [[ $install_opencode == true ]]; then
  opencode --version
fi
