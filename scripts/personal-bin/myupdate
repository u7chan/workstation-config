#!/usr/bin/env bash
set -uo pipefail

readonly PROGRAM_NAME="myupdate"
readonly STATE_DIR="$HOME/.local/state/workstation-update"
readonly LOCK_FILE="$STATE_DIR/update.lock"
readonly RETRY_DELAY_SECONDS="${WORKSTATION_UPDATE_RETRY_DELAY_SECONDS:-5}"
# Mirrors PI_PACKAGE_SOURCES in update-ai. tests/static/update-ai.sh keeps the
# two in sync because the coverage table prints the count.
readonly PI_PACKAGE_COUNT=4

die() {
  local exit_code=$1
  shift
  printf '%s: %s\n' "$PROGRAM_NAME" "$*" >&2
  exit "$exit_code"
}

config_file="$HOME/.config/workstation/myupdate.conf"
if [[ ! ${WORKSTATION_UPDATE_AI_TOOLS+x} && -r $config_file ]]; then
  # shellcheck source=/dev/null
  source "$config_file"
fi

[[ $RETRY_DELAY_SECONDS =~ ^[0-9]+([.][0-9]+)?$ ]] || die 2 "retry delay must be a non-negative number"
command -v flock >/dev/null 2>&1 || die 1 "flock is required"
command -v git >/dev/null 2>&1 || die 1 "git is required"

AI_UPDATE_ENABLED=true
declare -a UPDATE_AI_ARGS=()
declare -a SELECTED_AI_TOOLS=()
if [[ ${WORKSTATION_UPDATE_AI_TOOLS+x} ]]; then
  if [[ -z $WORKSTATION_UPDATE_AI_TOOLS ]]; then
    AI_UPDATE_ENABLED=false
  else
    IFS=',' read -r -a configured_ai_tools <<<"$WORKSTATION_UPDATE_AI_TOOLS"
    for configured_ai_tool in "${configured_ai_tools[@]}"; do
      case $configured_ai_tool in
        claude|opencode|pi)
          UPDATE_AI_ARGS+=("--$configured_ai_tool")
          [[ " ${SELECTED_AI_TOOLS[*]-} " == *" $configured_ai_tool "* ]] || \
            SELECTED_AI_TOOLS+=("$configured_ai_tool")
          ;;
        *) die 2 "invalid AI tool in WORKSTATION_UPDATE_AI_TOOLS: $configured_ai_tool" ;;
      esac
    done
  fi
else
  # update-ai installs every tool when no flag selects a subset.
  SELECTED_AI_TOOLS=(pi claude opencode)
fi

umask 077
mkdir -p "$STATE_DIR" || die 1 "cannot create state directory: $STATE_DIR"
exec 9>"$LOCK_FILE" || die 1 "cannot open update lock: $LOCK_FILE"
if ! flock -n 9; then
  printf '%s: another update is already running\n' "$PROGRAM_NAME" >&2
  exit 3
fi

run_update_ai() {
  local update_ai_bin="${WORKSTATION_UPDATE_AI_BIN:-$HOME/.local/bin/update-ai}"

  if [[ $AI_UPDATE_ENABLED == false ]]; then
    printf 'AI CLI update skipped: personal_ai_tools is empty\n'
    return 0
  fi

  [[ -x $update_ai_bin ]] || {
    printf 'update-ai is not executable: %s\n' "$update_ai_bin" >&2
    return 127
  }

  MISE_CONFIG_FILE="${MISE_CONFIG_FILE:-$HOME/.config/mise/config.toml}" \
  MISE_LOCKED=1 \
  MISE_YES=1 \
    "$update_ai_bin" "${UPDATE_AI_ARGS[@]}"
}

selected_ai_tool() {
  local tool
  for tool in "${SELECTED_AI_TOOLS[@]}"; do
    [[ $tool == "$1" ]] && return 0
  done
  return 1
}

# Show which update paths pass through Safe-chain. The minimum package age gate
# is the only Safe-chain feature with a per-install switch, and the Pi core is
# the only target that turns it off, so the table keeps that decision visible on
# every run.
print_safe_chain_coverage() {
  local age_hours=${SAFE_CHAIN_MINIMUM_PACKAGE_AGE_HOURS:-48}
  local tool

  [[ $age_hours =~ ^[0-9]+$ ]] || \
    die 2 "SAFE_CHAIN_MINIMUM_PACKAGE_AGE_HOURS must be a whole number of hours: $age_hours"

  printf '==> Safe-chain coverage\n'
  printf '%-18s %-10s %s\n' 'target' 'npm path' 'age gate'
  for tool in pi claude opencode; do
    selected_ai_tool "$tool" || continue
    case $tool in
      pi)
        printf '%-18s %-10s %s\n' 'pi core' 'yes' 'skipped'
        printf '%-18s %-10s %s\n' "pi packages ($PI_PACKAGE_COUNT)" 'yes' "${age_hours}h"
        ;;
      *) printf '%-18s %-10s %s\n' "$tool" 'no' '-' ;;
    esac
  done
  printf '%-18s %-10s %s\n' 'herdr' 'no' '-'
}

run_herdr_update() {
  local mise_bin="${WORKSTATION_UPDATE_MISE_BIN:-$HOME/.local/bin/mise}"
  local mise_config_file="${MISE_CONFIG_FILE:-$HOME/.config/mise/config.toml}"

  [[ -x $mise_bin ]] || {
    printf 'mise is not executable: %s\n' "$mise_bin" >&2
    return 127
  }

  MISE_CONFIG_FILE="$mise_config_file" \
  MISE_YES=1 \
    env -u MISE_LOCKED "$mise_bin" upgrade herdr || return $?
}

# Stream a step to the console while keeping a copy for failure classification.
# pipefail (set above) preserves the step's exit code through the pipe. The copy
# makes the step's stdout a pipe, so installers that detect a TTY may print less.
run_attempt() {
  local log_file=$1
  shift
  "$@" 2>&1 | tee -a "$log_file"
}

# Classify a captured step log. SafeChain blocks are deterministic: the same
# install hits the same block until a package ages out or upstream removes a
# malicious release, so they must not consume the retry. Match only the block
# messages: a successful install still prints "Some package versions were
# suppressed during package metadata resolution due to minimum package age.",
# so a substring match on "minimum package age" would misread a later
# transient failure of the same step.
classify_failure() {
  local log_file=$1

  if grep -qE 'direct download minimum package age|direct package download request\(s\) due to minimum package age' "$log_file"; then
    printf 'safe-chain-minimum-package-age'
  elif grep -qE 'Exiting without installing malicious packages|Malicious changes detected' "$log_file"; then
    printf 'safe-chain-malware'
  elif grep -qF 'blocked by safe-chain' "$log_file"; then
    printf 'safe-chain-block'
  else
    printf 'unknown'
  fi
}

failure_reason_label() {
  case $1 in
    safe-chain-minimum-package-age) printf 'SafeChain minimum package age' ;;
    safe-chain-malware) printf 'SafeChain malware block' ;;
    safe-chain-block) printf 'SafeChain block' ;;
    *) printf '%s' "$1" ;;
  esac
}

# Keep one captured log per step so a later failing step cannot overwrite the
# SafeChain output that explains an earlier one.
step_log_path() {
  printf '%s/step-%s.log\n' "$STATE_DIR" "${1//[^[:alnum:]._-]/-}"
}

report_blocked_packages() {
  local log_file=$1
  local package
  local -a stopped_packages=() listed_packages=()
  local -A reported=()

  # The 403 line names the package npm stopped on, so print those first; the
  # SafeChain summary then adds every other blocked download without silently
  # truncating the list.
  mapfile -t stopped_packages < <(grep -oE 'blocked by safe-chain[^(]*\(([^)]+)\)' "$log_file" \
    | sed -E 's/.*\(([^)]+)\)/\1/' | sort -u)
  mapfile -t listed_packages < <(grep -oE '^ - [^ ()]+@[^ ()]+' "$log_file" \
    | sed -E 's/^ - //' | sort -u)

  for package in "${stopped_packages[@]}" "${listed_packages[@]}"; do
    [[ -n $package ]] || continue
    [[ -z ${reported[$package]:-} ]] || continue
    reported["$package"]=1
    printf '%s:   - %s\n' "$PROGRAM_NAME" "$package" >&2
  done
}

report_failure_reason() {
  local category=$1 label=$2 exit_code=$3 log_file=$4

  case $category in
    safe-chain-minimum-package-age)
      printf '%s: %s failed (exit %s): SafeChain blocked downloads under its minimum package age (48h by default)\n' \
        "$PROGRAM_NAME" "$label" "$exit_code" >&2
      report_blocked_packages "$log_file"
      printf '%s: retry skipped; wait for the packages to age out, or resolve with npm_config_before like update-ai\n' \
        "$PROGRAM_NAME" >&2
      ;;
    safe-chain-malware)
      printf '%s: %s failed (exit %s): SafeChain blocked a malicious package download\n' \
        "$PROGRAM_NAME" "$label" "$exit_code" >&2
      printf '%s: retry skipped; inspect the captured output before installing anything\n' \
        "$PROGRAM_NAME" >&2
      ;;
    safe-chain-block)
      printf '%s: %s failed (exit %s): SafeChain blocked a download\n' \
        "$PROGRAM_NAME" "$label" "$exit_code" >&2
      printf '%s: retry skipped because the block is deterministic\n' "$PROGRAM_NAME" >&2
      ;;
  esac
  printf '%s: captured output: %s\n' "$PROGRAM_NAME" "$log_file" >&2
}

run_step() {
  local label=$1
  shift
  local attempt exit_code=0 category=unknown
  local log_file
  log_file="$(step_log_path "$label")"

  for attempt in 1 2; do
    : >"$log_file"
    if ((attempt == 1)); then
      printf '==> %s\n' "$label"
    fi

    exit_code=0
    run_attempt "$log_file" "$@" || exit_code=$?
    if ((exit_code == 0)); then
      return 0
    fi
    category="$(classify_failure "$log_file")"

    if [[ $category != unknown ]]; then
      report_failure_reason "$category" "$label" "$exit_code" "$log_file"
      FAILURE_REASONS["$label"]="$category"
      return 1
    fi

    if ((attempt == 1)); then
      printf '%s: %s failed (exit %s); retrying in %s seconds\n' \
        "$PROGRAM_NAME" "$label" "$exit_code" "$RETRY_DELAY_SECONDS" >&2
      sleep "$RETRY_DELAY_SECONDS"
    fi
  done

  printf '%s: %s failed after 2 attempts (exit %s)\n' \
    "$PROGRAM_NAME" "$label" "$exit_code" >&2
  return 1
}

declare -a FAILED_STEPS=()
declare -A FAILURE_REASONS=()
print_safe_chain_coverage

run_step update-ai run_update_ai || FAILED_STEPS+=(update-ai)
run_step 'mise upgrade herdr' run_herdr_update || FAILED_STEPS+=('mise upgrade herdr')

if ((${#FAILED_STEPS[@]} > 0)); then
  failed_summary=''
  for failed_step in "${FAILED_STEPS[@]}"; do
    reason="${FAILURE_REASONS[$failed_step]:-}"
    [[ -z $failed_summary ]] || failed_summary+=', '
    if [[ -n $reason ]]; then
      failed_summary+="$failed_step ($(failure_reason_label "$reason"))"
    else
      failed_summary+="$failed_step"
    fi
  done
  printf '%s: update failed: %s\n' "$PROGRAM_NAME" "$failed_summary" >&2
  printf '%s: captured step output: %s/\n' "$PROGRAM_NAME" "$STATE_DIR" >&2
  exit 1
fi

printf '%s: all updates completed successfully\n' "$PROGRAM_NAME"
